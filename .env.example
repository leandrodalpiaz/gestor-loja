# ============================================================
# Banco de dados (Supabase — connection pooler)
# ============================================================
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASS=SUA_SENHA_SUPABASE

# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=SEU_BOT_TOKEN

# ID do grupo/canal onde as efemérides são publicadas
TELEGRAM_CHAT_ID_GROUP=-100XXXXXXXXXX

# Chat privado do Chanceler (para prévia antes de publicar)
TELEGRAM_CHAT_ID_CHANCELER=XXXXXXXXXX

# ============================================================
# Aplicação
# ============================================================
# URL pública sem barra final — usada nos botões Mini App do bot
APP_URL=https://seu-dominio.com

# Defina true apenas em ambiente de homologação (abre o painel sem login)
APP_TEST_OPEN_ACCESS=false

# Token secreto para proteger a rota /cron/efemerides
# Troque por um valor aleatório longo em produção
CRON_SECRET_TOKEN=troque-por-valor-secreto-aleatório