# ============================================================
# Banco de dados (Supabase - connection pooler)
# ============================================================
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASS=SUA_SENHA_SUPABASE

# ============================================================
# Telegram Bot
# ============================================================
TELEGRAM_BOT_TOKEN=SEU_BOT_TOKEN

# Admin do sistema (fora dos cargos da loja). Lista de telegram_id separados por virgula.
# Ex.: SYSTEM_ADMIN_TELEGRAM_IDS=8062119710,123456789
SYSTEM_ADMIN_TELEGRAM_IDS=

# Deep link do bot para convites de ativacao.
# Prioridade: TELEGRAM_BOT_DEEPLINK_BASE, fallback: TELEGRAM_BOT_USERNAME.
TELEGRAM_BOT_DEEPLINK_BASE=
TELEGRAM_BOT_USERNAME=

# Variavel principal para chat de grupo/canal
TELEGRAM_CHAT_ID_GROUP=-100XXXXXXXXXX

# Chat privado do chanceler (previa antes de publicar)
TELEGRAM_CHAT_ID_CHANCELER=XXXXXXXXXX

# Aliases de compatibilidade (opcional)
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_GRUPO_ID=

# ============================================================
# Aplicacao
# ============================================================
# Em dev local sem tunel, use http://localhost:8000
# Para Telegram Mini App/Webhook, use URL publica HTTPS do tunel
APP_URL=http://localhost:8000
PUBLIC_ADS_ENABLED=false
APP_TIMEZONE=America/Sao_Paulo

# Credenciais padrao de homologacao
APP_TEST_DEFAULT_LOGIN=
APP_TEST_DEFAULT_PASSWORD=
APP_TEST_DEFAULT_ROLE=tesoureiro
APP_TEST_DEFAULT_NAME=Modo Teste
APP_TEST_ALLOW_ALL_PANELS=true
APP_TEST_OPEN_ACCESS=false

# Opcional: usado apenas pelo scripts/checklist_local.ps1 para validar login real
CHECK_LOGIN_CIM=23709
CHECK_LOGIN_PASSWORD=1547

# Keep alive (opcional)
KEEPALIVE_TARGET_URL=

# Token para rota /api/cron/efemerides-diarias
# Pode usar apenas um deles; CRON_EFEMERIDES_TOKEN tem prioridade
CRON_EFEMERIDES_TOKEN=troque-por-valor-secreto-aleatorio
CRON_SECRET_TOKEN=
